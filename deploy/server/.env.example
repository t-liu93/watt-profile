# Owner-managed standalone settings; no development password defaults.
# External browser origin; HTTPS terminates at owner-managed host/upstream Nginx.
WATT_SERVER_PUBLIC_ORIGIN=https://server.example.invalid
WATT_SERVER_BIND_ADDRESS=127.0.0.1
WATT_SERVER_PUBLISHED_PORT=18081
# Keep true behind HTTPS; false only for explicit owner-managed HTTP/tunnels.
WATT_SERVER_COOKIE_SECURE=true
WATT_SERVER_ADMIN_USER=admin
WATT_SERVER_IMAGE_TAG=owner-build
# Existing private 0700 directories, mounted read-only.
# DB directory: password (0600; postgres root entrypoint reads it).
WATT_SERVER_DB_SECRET_DIR=/replace/private/db-credentials
# Server directory owned by UID/GID 10001: database-url and admin-password (0600).
# URL: postgresql+psycopg://watt:<same URL-safe DB password>@server-db:5432/watt
WATT_SERVER_SECRET_DIR=/replace/private/server-credentials
# Optional published image (use an actual release version; omit for a local build):
# WATT_SERVER_IMAGE=ghcr.io/OWNER/REPOSITORY-server:0.1.0
