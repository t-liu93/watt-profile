# Copy to an ignored .env.local and replace every placeholder before deployment.
# Optional published image (use an actual release version; omit for a local build):
# WATT_LOGGER_IMAGE=ghcr.io/OWNER/REPOSITORY-logger:0.1.0
WATT_LOGGER_OPERATOR_USER=replace-with-operator-name
WATT_LOGGER_OPERATOR_PASSWORD_FILE=/absolute/private/path/operator.secret
WATT_LOGGER_SERIAL_DEVICE=/dev/serial/by-id/replace-with-device
WATT_LOGGER_SERIAL_GID=replace-with-numeric-device-gid
WATT_LOGGER_BIND_ADDRESS=127.0.0.1
WATT_LOGGER_PUBLISHED_PORT=8080
WATT_LOGGER_COOKIE_SECURE=false
